<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".WoWsInfoApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WoWsInfo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WoWsInfo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.WoWsInfo" />
        <activity
            android:name=".ShipDetailActivity"
            android:exported="false"
            android:parentActivityName=".PlayerActivity"
            android:theme="@style/Theme.WoWsInfo" />
        <activity
            android:name=".ClanActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.WoWsInfo" />
        <activity
            android:name=".RealtimeActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.WoWsInfo" />
        <activity
            android:name=".WikiActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.WoWsInfo" />
    </application>

</manifest>
